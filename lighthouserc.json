{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/", "/faq", "/imprimantes/canon-g2470"],
      "numberOfRuns": 2,
      "settings": {
        "preset": "mobile",
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 13; SM-A135F) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 360000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1500000 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
        "heading-order": "warn",
        "color-contrast": "error",
        "button-name": "error",
        "link-name": "error",
        "image-alt": "error",
        "tap-targets": "warn"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
